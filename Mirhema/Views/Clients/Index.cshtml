@model List<ClientEntity>
<br/>
<div class="container p-4 border">
	<div class="row pb-2">

		<div class="col">
			<h1 class="text-primary">Clients</h1>
		</div>

		<div class="col text-end p1-1">
			<a asp-controller="Clients" asp-action="Create" class="btn btn-primary"> New Client </a>
		</div>

	</div>
	<table class="table">
		<thead>
			<tr>
				<th>Client_ID</th>
				<th>Client_Name</th>
				<th>Client_Telephone</th>
				<th>Client_Address</th>
				<th>TIN</th>
				<th>Payment_Terms</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				 <tr>
						<td>@item.Client_ID</td>
						<td>@item.Client_Name</td>
						<td>@item.Client_Telephone</td>
						<td>@item.Client_Address</td>
						<td>@item.TIN</td>
						<td>@item.Payment_Terms</td>
						<td>
							<a asp-controller="Clients" asp-action="Details" asp-route-iD="@item.Client_ID" class="btn btn-primary"> Details</a>
							<a asp-controller="Clients" asp-action="Delete" asp-route-iD="@item.Client_ID" class="btn btn-primary"> Delete</a>
						</td>
				 </tr>
			}
		</tbody>
	</table>
</div>